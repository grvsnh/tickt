# Tickt is local-first and never requires credentials, API keys, or secrets.
# It does not load .env files automatically. Source this file from your shell
# only when you want an isolated project-local data directory:
#
#   set -a; . ./.env; set +a; cargo run --locked
#
# These paths use $PWD so the example stays portable across machines.
XDG_CONFIG_HOME="$PWD/.tickt/config"
XDG_DATA_HOME="$PWD/.tickt/data"
XDG_STATE_HOME="$PWD/.tickt/state"
